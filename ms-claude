#!/usr/bin/env bash
# ms-claude - 启动独立的 ms-claude 实例
# 与原版 Claude 并存，互不影响

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_DIR="$SCRIPT_DIR"

# 编码保障：确保 Claude CLI 以 UTF-8 运行，避免中文乱码
export LC_ALL="${LC_ALL:-C.utf8}"
export LANG="${LANG:-C.utf8}"

# WSL 下还需要设置 Windows Console 代码页为 UTF-8，否则 Node.js 应用（如 Claude CLI）
# 会读取 Windows 的默认代码页（如 GBK/936）而非 WSL locale，导致中文乱码。
if grep -qEi "microsoft|wsl" /proc/sys/kernel/osrelease 2>/dev/null; then
    chcp.com 65001 >/dev/null 2>&1 || true
fi

# 默认配置
export MS_CLAUDE_HOME="${MS_CLAUDE_HOME:-$HOME/.config/ms-claude}"
export MS_CLAUDE_PORT="${MS_CLAUDE_PORT:-8081}"
CLIENT_CMD="${CLIENT_CMD:-claude}"

show_help() {
    cat <<EOF
ms-claude - 启动独立的 Claude 实例（使用 ModelScope 代理）

用法:
  ms-claude [选项]

选项:
  --serve           仅启动代理服务，不启动 Claude 客户端
  --status          查看代理状态
  --update          更新模型列表
  --test            测试代理功能
  --port PORT       指定代理端口（默认: 8081）
  --home PATH       指定配置目录（默认: ~/.config/ms-claude）
  --client-cmd CMD  指定 Claude 客户端命令（默认: claude）
  --verbose, -v     显示详细日志
  --help, -h        显示此帮助信息

环境变量:
  MS_CLAUDE_HOME    配置目录
  MS_CLAUDE_PORT    代理端口
  CLIENT_CMD        Claude 客户端命令

示例:
  ms-claude                    # 一键启动代理和 Claude
  ms-claude --serve            # 仅启动代理服务
  ms-claude --port 8082        # 使用 8082 端口
  MS_CLAUDE_PORT=9090 ms-claude  # 通过环境变量指定端口

注意:
  原版 Claude 使用 ~/.claude/settings.json
  ms-claude 使用 ~/.config/ms-claude/.claude/settings.json
  两者完全隔离，互不影响。
EOF
}

# 解析参数
EXTRA_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --port)
            export MS_CLAUDE_PORT="$2"
            shift 2
            ;;
        --home)
            export MS_CLAUDE_HOME="$2"
            shift 2
            ;;
        --client-cmd)
            CLIENT_CMD="$2"
            shift 2
            ;;
        --serve|--status|--update|--test|--verbose|-v)
            EXTRA_ARGS+=("$1")
            shift
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ " ${EXTRA_ARGS[*]} " =~ " --serve " ]] || [[ " ${EXTRA_ARGS[*]} " =~ " --status " ]] || [[ " ${EXTRA_ARGS[*]} " =~ " --update " ]] || [[ " ${EXTRA_ARGS[*]} " =~ " --test " ]]; then
    # 非 connect 模式，直接调用 Python 模块
    cd "$PROXY_DIR"
    python3 -m src.main "${EXTRA_ARGS[@]}"
else
    # 默认 connect 模式：启动代理 + Claude 客户端
    echo "=========================================="
    echo "  ms-claude 独立实例启动"
    echo "=========================================="
    echo "  配置目录: $MS_CLAUDE_HOME"
    echo "  代理端口: $MS_CLAUDE_PORT"
    echo "  客户端:   $CLIENT_CMD"
    echo "=========================================="
    echo ""
    echo "原版 Claude 配置: ~/.claude/settings.json"
    echo "ms-claude 配置:   $MS_CLAUDE_HOME/.claude/settings.json"
    echo ""

    # === 工作区隔离方案 ===
    # Claude Code 支持工作区级别配置 .claude/settings.local.json，覆盖全局配置。
    # ms-claude 在独立工作目录启动 Claude，该目录下有 settings.local.json 指向代理。
    # 原版 Claude 在自己的工作目录启动，读全局 ~/.claude/settings.json，完全不受影响。

    WORKSPACE_DIR="$MS_CLAUDE_HOME/workspace"
    LOCAL_SETTINGS="$WORKSPACE_DIR/.claude/settings.local.json"
    GLOBAL_SETTINGS="$HOME/.claude/settings.json"

    # 1. 确保全局配置是原版（如果之前被替换过，恢复它）
    if [[ -f "$GLOBAL_SETTINGS" ]]; then
        if grep -q "PROXY_MANAGED" "$GLOBAL_SETTINGS" 2>/dev/null; then
            # 全局配置被代理替换过，尝试恢复原版
            if [[ -f "$HOME/.claude/settings.json.ms-claude-backup" ]]; then
                cp "$HOME/.claude/settings.json.ms-claude-backup" "$GLOBAL_SETTINGS"
                echo "已恢复原版 Claude 全局配置"
            else
                echo "警告: 全局配置似乎被代理修改过，但没有备份。请手动检查 $GLOBAL_SETTINGS"
            fi
        fi
    fi

    # 2. 在工作区创建 settings.local.json（代理配置）
    mkdir -p "$WORKSPACE_DIR/.claude"
    cat > "$LOCAL_SETTINGS" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:$MS_CLAUDE_PORT",
    "ANTHROPIC_AUTH_TOKEN": "PROXY_MANAGED",
    "ANTHROPIC_MODEL": "",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {}
}
EOF
    echo "已创建工作区配置: $LOCAL_SETTINGS"

    # 3. 在工作区目录下启动 Claude
    echo ""
    echo "启动 Claude（工作区: $WORKSPACE_DIR）..."
    echo "  - 全局配置: $GLOBAL_SETTINGS（原版，不受影响）"
    echo "  - 工作区配置: $LOCAL_SETTINGS（代理配置）"
    echo ""

    export MS_CLAUDE_WORKSPACE="$WORKSPACE_DIR"
    cd "$PROXY_DIR"
    python3 -m src.main --connect --client-cmd "$CLIENT_CMD" --port "$MS_CLAUDE_PORT" "${EXTRA_ARGS[@]}"
fi
