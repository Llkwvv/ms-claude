# ================================
# ms-claude 部署环境变量示例
# 复制为 .env 后填入真实值
# ================================

# 【必填】上游模型服务的 API Key
# 支持 ModelScope / OpenAI / 其他 OpenAI 兼容端点
MS_CLAUDE_UPSTREAM_API_KEY=your_api_key_here

# 【可选】上游地址（默认 ModelScope）
# MS_CLAUDE_UPSTREAM_BASE_URL=https://api-inference.modelscope.cn

# 【可选】代理监听地址（默认 127.0.0.1:8080）
# MS_CLAUDE_HOST=0.0.0.0
# MS_CLAUDE_PORT=8080

# 【可选】应用主目录（配置/缓存/日志隔离存放）
# MS_CLAUDE_HOME=/opt/ms-claude

# 【可选】日志级别
LOG_LEVEL=INFO

# 【可选】强制指定默认模型（跳过优先级列表）
# MS_CLAUDE_MODEL=qwen-max

# 【可选】调试模式
DEBUG=false